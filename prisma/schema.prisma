generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// プラン全体の基本設定
model Plan {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 家族の名前（未設定時は「本人」「配偶者」「子1」「子2」）
  nameSelf    String?
  nameSpouse  String?
  nameChild1  String?
  nameChild2  String?

  // 家族の生まれ年
  birthYearSelf   Int
  birthYearSpouse Int
  birthYearChild1 Int?
  birthYearChild2 Int?

  // 初期資産（万円）
  initialCash       Int @default(0)
  initialInvestment Int @default(0)

  // 基本収入（万円/年）
  baseSalaryself   Int @default(0)
  baseSalarySpouse Int @default(0)

  // 年金（万円/年）
  pensionSelf   Int @default(0)
  pensionSpouse Int @default(0)
  pensionAgeSelf   Int @default(65)
  pensionAgeSpouse Int @default(65)

  // 退職年齢
  retirementAgeSelf   Int @default(65)
  retirementAgeSpouse Int @default(65)

  // 固定支出（万円/年）
  annualLivingCost   Int @default(0)
  annualHousingCost  Int @default(0)
  annualInsurance    Int @default(0)

  // 運用利回り（%）
  investmentRate Float @default(3.0)

  // 給与上昇率（%/年、複利）
  salaryGrowthRateSelf   Float @default(0.0)
  salaryGrowthRateSpouse Float @default(0.0)

  // 生活費上昇率（%/年）
  livingCostGrowthRate Float @default(0.0)

  events PlanEvent[]
}

// 年ごとのライフイベント（収入変化・支出イベント）
model PlanEvent {
  id     String @id @default(cuid())
  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  ageSelf Int    // 本人の年齢（イベント発生時）
  title   String
  note    String?

  // 収入変化（万円/年、その年以降に加算）
  salaryChangeSelf   Int @default(0)
  salaryChangeSpouse Int @default(0)
  temporaryIncome    Int @default(0)

  // 支出（万円、その年のみ）
  eventExpense Int @default(0)

  // NISA変更（万円/年、その年以降）
  nisaChange Int @default(0)

  // 車費用（万円/年）
  carCostChange Int @default(0)

  // 住宅ローン控除（万円/年）・適用期間（本人年齢）
  mortgageDeduction       Int  @default(0)
  mortgageDeductionEndAge Int? // nullの場合は1年のみ

  // 児童手当変化（万円/年）
  childAllowanceChange Int @default(0)

  // 教育費変化（万円/年）
  educationCostChange Int @default(0)

  // 借入金返済変化（万円/年）
  loanRepaymentChange Int @default(0)

  // 生活費・住宅関連費・保険料変化（万円/年）
  livingCostChange  Int @default(0)
  housingCostChange Int @default(0)
  insuranceChange   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
